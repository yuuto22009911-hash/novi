{
  "name": "novi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "lint": "biome check . && pnpm check:source && pnpm check:handwritten && pnpm check:changeset && turbo run check:design",
    "check:source": "node scripts/check-source-rules.mjs",
    "check:handwritten": "node scripts/check-handwritten-api.mjs",
    "accuracy": "node accuracy/run.mjs",
    "check:dist": "node scripts/check-dist-rules.mjs && turbo run check:treeshaking && turbo run check:security && pnpm check:skill",
    "format": "biome check --write .",
    "size": "turbo run size",
    "changeset": "changeset",
    "release": "turbo run build && pnpm publish -r --access public --no-git-checks",
    "check:changeset": "node scripts/check-changeset-mcp.mjs",
    "generate:skill": "node apps/docs/scripts/generate-skill.mjs",
    "check:skill": "node scripts/check-skill.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@changesets/cli": "3.0.1",
    "turbo": "2.10.11",
    "typescript": "6.0.3"
  }
}
