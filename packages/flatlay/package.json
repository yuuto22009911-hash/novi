{
  "name": "@novi-ui/flatlay",
  "version": "0.2.0",
  "description": "Novi UI theme 3 — no z-axis. Opening takes space: inflow expansion, full-screen takeover, rules instead of shadows.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuuto22009911-hash/novi.git",
    "directory": "packages/flatlay"
  },
  "homepage": "https://novi-42r.pages.dev",
  "bugs": "https://github.com/yuuto22009911-hash/novi/issues",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./flatlay.css": "./dist/flatlay.css",
    "./flatlay.scoped.css": "./dist/flatlay.scoped.css"
  },
  "scripts": {
    "build": "tsdown && node scripts/generate-theme-css.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "check:design": "node scripts/check-design-rules.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "check:treeshaking": "node scripts/check-treeshaking.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-aria-components": "^1.20.0"
  },
  "dependencies": {
    "@novi-ui/core": "workspace:*",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@novi-ui/raster": "workspace:*",
    "@novi-ui/tactile": "workspace:*",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.3",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
