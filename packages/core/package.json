{
  "name": "@novi-ui/core",
  "version": "0.1.1",
  "description": "Behavior, accessibility, type contracts and token conventions for Novi UI. Ships zero styles.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client/index.d.mts",
      "default": "./dist/client/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.mts",
      "default": "./dist/testing/index.mjs"
    },
    "./base.css": "./dist/base.css"
  },
  "scripts": {
    "build": "tsdown && node scripts/generate-base-css.mjs",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@testing-library/react": "^16.0.0",
    "react": "^19.0.0",
    "react-aria-components": "^1.20.0",
    "vitest": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^13.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.8",
    "size-limit": "^13.0.3",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
